# Copier ce fichier en `.env` (jamais commité) puis renseigner les valeurs.

# Clé API Mistral : https://console.mistral.ai/api-keys
MISTRAL_API_KEY=

# Jeton de l'intégration interne Notion : https://www.notion.so/profile/integrations
NOTION_TOKEN=

# (Facultatif) URL de la page racine « Cours M1 » partagée avec l'intégration.
# Modifiable ensuite dans Paramètres.
NOTION_URL=

# (Facultatif) Port d'écoute — l'app n'écoute que sur 127.0.0.1.
# PORT=8000
